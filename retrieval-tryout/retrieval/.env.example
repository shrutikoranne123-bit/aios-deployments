# =============================================================================
# Retrieval service environment — copy to `.env` and fill in real values.
# =============================================================================
# The retrieval service reads these at startup (retrieval_new.py loads .env via
# python-dotenv). Backend credentials (Qdrant/Pinecone/etc.) are normally sent
# per-request in `vector_store_details`, so they are NOT required here — only
# the server-wide AWS / model config is.
# =============================================================================

# --- Server -----------------------------------------------------------------
PORT=8000
# Number of uvicorn workers in the container. Keep at 1 and scale with
# replicas; the tool-store file lock is simplest with a single writer per pod.
UVICORN_WORKERS=1

# --- AWS Bedrock (query embedding + answer generation) ----------------------
# boto3 resolves credentials from the standard chain. In AWS, prefer an IAM
# role (IRSA on EKS / task role on ECS) over static keys. For local dev you may
# set the keys below.
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
# AWS_SESSION_TOKEN=

# Bedrock model ids (override only if your account enables different ones).
BEDROCK_EMBED_MODEL=cohere.embed-multilingual-v3
BEDROCK_EMBED_ENABLED=1
# Answer-generation model (Anthropic Claude on Bedrock).
BEDROCK_CHAT_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_CHAT_MAX_TOKENS=1024

# --- OpenAI (optional fallback only; Bedrock is the default) ----------------
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_CHAT_MODEL=

